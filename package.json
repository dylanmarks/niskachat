{
  "name": "niskachat",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:backend": "node backend/server.js",
    "start:dev": "concurrently \"npm run start:backend\" \"npm run start\"",
    "reload-prompts": "node backend/utils/reloadPrompts.js",
    "test-providers": "node backend/test-providers.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "test:backend": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:backend:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "format:base": "prettier --log-level warn --ignore-path=./.gitignore  \"**/*.{js,ts,css,scss,sh,html,md,json,yaml,yml}\"",
    "format": "npm run format:base -- --write",
    "lint": "eslint -f mo \"**/*.{js,ts,html,json}\"",
    "lint:style": "stylelint --ignore-path .gitignore \"**/*.{css,scss}\"",
    "lint:spelling": "cspell --quiet \"**/*\"",
    "lint:tsc:app": "tsc --noEmit -p tsconfig.app.json",
    "lint:tsc:spec": "tsc --noEmit -p tsconfig.spec.json",
    "lint:tsc:all": "npm run lint:tsc:app && npm run lint:tsc:spec",
    "lint:format": "npm run format:base -- --check",
    "lint:all": "npm run lint:tsc:all && npm run lint && npm run lint:style && npm run lint:spelling && npm run lint:format",
    "ci:all": "npm run lint:all && npm run test:ci",
    "a11y:test": "pa11y http://localhost:4200 --runner axe --standard WCAG2AA",
    "a11y:test-offline": "pa11y http://localhost:4200 --runner axe --standard WCAG2AA --wait 3000",
    "a11y:report": "pa11y http://localhost:4200 --runner axe --standard WCAG2AA --reporter json > accessibility-report.json",
    "shove": "git config push.autoSetupRemote true && git add . && git commit -m 'wip: shoved' --no-verify && git push --no-verify",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@google/genai": "^1.15.0",
    "@types/dompurify": "^3.0.5",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "dotenv": "^17.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "fhirclient": "^2.6.3",
    "helmet": "^7.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.5.0",
    "concurrently": "^8.2.2",
    "cspell": "^10.3.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-mo": "^2.4.1",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-jsonc": "^3.4.2",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.7.0",
    "jest": "^30.5.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.1.0",
    "pa11y": "^9.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sh": "^0.20.2",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "supertest": "^7.2.2",
    "tsc-files": "^1.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
