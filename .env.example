# ==============================================
# NiskaChat Environment Configuration
# ==============================================
# Copy this file to .env and populate with your actual values
# The .env file is gitignored for security

# ==============================================
# LLM Provider Configuration
# ==============================================

# Preferred LLM provider: openrouter | ollama | claude-haiku | gemini-vertex
LLM_PROVIDER=openrouter

# ==============================================
# 1. OpenRouter Configuration (Recommended)
# Unified access to Claude 3.5, Llama 3.3, DeepSeek, etc.
# ==============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional settings:
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# OPENROUTER_MAX_TOKENS=1500
# OPENROUTER_TEMPERATURE=0.2

# ==============================================
# 2. Ollama Configuration (Local / Offline Private AI)
# ==============================================
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_MAX_TOKENS=1500
# OLLAMA_TEMPERATURE=0.2

# ==============================================
# 3. Claude Haiku Configuration (Direct Anthropic)
# ==============================================
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-3-haiku-20240307

# ==============================================
# 4. Gemini Configuration (Direct Google API)
# ==============================================
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-pro

# ==============================================
# Server & Security Configuration
# ==============================================
PORT=3000
SESSION_SECRET=your_random_secret_string_here
CORS_ORIGINS=http://localhost:4200
NODE_ENV=development